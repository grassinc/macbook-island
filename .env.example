# Pill — nümunə konfiqurasiya.
#
# Bu faylı `.env` adı ilə kopyalayın və dəyərləri doldurun:
#     cp .env.example .env
#
# `.env` heç vaxt git-ə göndərilmir (.gitignore-dadır).
# Paketlənmiş tətbiq üçün fayl bu ünvanda axtarılır:
#     ~/Library/Application Support/Pill/.env

# Hazırda heç bir açar tələb olunmur: Spotify AppleScript ilə idarə olunur,
# bütün sistem məlumatları isə açıq (public) API-lərdən oxunur.
# Aşağıdakılar gələcək inteqrasiyalar üçün yer tutucudur.

# LASTFM_API_KEY=
# OPENWEATHER_API_KEY=
# GITHUB_TOKEN=
