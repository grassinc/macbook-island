<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required to send Apple events under the hardened runtime. Without it
         tccd refuses with "requires entitlement
         com.apple.security.automation.apple-events but it is missing" and no
         consent prompt is ever shown. Needed for Spotify/Music track info. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
